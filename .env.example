# Copy to .env and fill in. Never commit .env.

# Database
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/klyron_crm"
# Only needed for `prisma migrate dev` (local)
SHADOW_DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/klyron_crm_shadow"

# Super admin (Owner). Created by `npm run db:seed`.
# Re-run with `-- --reset-password` to restore access with these credentials.
SUPERADMIN_NAME="Studio Owner"
SUPERADMIN_EMAIL="admin@klyron.com"
SUPERADMIN_PASSWORD="change-me-to-a-long-random-password"

# Public base URL, used for invite and password-reset links
APP_URL="http://localhost:3000"

# Time zone used to display dates and compute "today" (IANA name)
NEXT_PUBLIC_APP_TIME_ZONE="Asia/Karachi"

# File storage: absolute folder on the VPS (e.g. /data/uploads); defaults to ./storage/uploads
UPLOAD_DIR=""
MAX_UPLOAD_MB="500"
# Set to "1" behind Nginx to hand file downloads to Nginx (X-Accel-Redirect to /protected-files/)
NGINX_ACCEL_REDIRECT=""

# Email (SMTP). Gmail/Workspace: smtp.gmail.com, 465, true + an App Password. Zoho: smtp.zoho.com, 465, true.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Klyron Studio <crm@klyronstudio.com>"

# ─── Video calls (Phase 5): self-hosted LiveKit ───
# Dev: run `livekit-server --dev` (uses devkey / secret on ws://localhost:7880).
# VPS: wss://livekit.klyronstudio.com with the keys from livekit.yaml (see deploy/livekit.example.yaml).
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"

# ─── AI meeting notes: Groq (https://console.groq.com/keys) ───
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
