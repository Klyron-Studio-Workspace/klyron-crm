// Klyron Studio CRM — database schema
// Every model maps to an explicit lowercase table name (@@map) so migrations behave
// the same on Windows/XAMPP (case-insensitive) and Linux MySQL (case-sensitive).
// Phase 0: identity, sessions, access control, audit log, org settings.

generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "mysql"
}

// ─── Identity ───────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
  CLIENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique @db.VarChar(254)
  name               String     @db.VarChar(120)
  title              String?    @db.VarChar(120)
  role               Role       @default(MEMBER)
  status             UserStatus @default(ACTIVE)
  passwordHash       String     @db.VarChar(255)
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime   @default(now())
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// Set for CLIENT accounts: the client record whose portal they can see.
  clientId           String?
  client             Client?    @relation("ClientAccounts", fields: [clientId], references: [id], onDelete: Cascade)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions    Session[]
  resetTokens PasswordResetToken[]

  leadsOwned        Lead[]              @relation("LeadOwner")
  leadsCreated      Lead[]              @relation("LeadCreator")
  leadNotes         LeadNote[]
  remindersAssigned Reminder[]          @relation("ReminderAssignee")
  remindersCreated  Reminder[]          @relation("ReminderCreator")
  clientsOwned      Client[]            @relation("ClientOwner")
  projectsOwned     Project[]           @relation("ProjectOwner")
  projectMembership ProjectMember[]
  tasksAssigned     Task[]              @relation("TaskAssignee")
  tasksCreated      Task[]              @relation("TaskCreator")
  channelMembership ChannelMember[]
  messages          Message[]
  filesUploaded     StoredFile[]
  notifications     Notification[]
  channelsCreated   Channel[]           @relation("ChannelCreator")
  proposalsCreated  Proposal[]
  invoicesCreated   Invoice[]
  paymentsRecorded  Payment[]
  expensesCreated   Expense[]
  callsStarted      Call[]              @relation("CallStarter")
  callsJoined       CallParticipant[]
  transcriptLines   TranscriptSegment[]
  whiteboardsCreated Whiteboard[]          @relation("WhiteboardCreator")
  whiteboardVersions WhiteboardVersion[]   @relation("WhiteboardVersionCreator")
  whiteboardMemberships WhiteboardMember[]
  whiteboardComments WhiteboardComment[]

  @@index([role, status])
  @@index([clientId])
  @@map("user")
}

model Session {
  id         String    @id @default(cuid())
  /// SHA-256 of the cookie token. The raw token is never stored.
  tokenHash  String    @unique @db.Char(64)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(512)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Char(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_token")
}

/// Every login attempt, used for rate limiting by IP and by email.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(254)
  ipAddress String?  @db.VarChar(45)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempt")
}

// ─── Access control ─────────────────────────────────────────────────────────

enum Access {
  NONE
  READ
  WRITE
}

/// Overrides of the default permission matrix in lib/auth/permissions.ts.
model RolePermission {
  role   Role
  module String @db.VarChar(40)
  access Access

  @@id([role, module])
  @@map("role_permission")
}

// ─── Events (audit log, activity feed, timelines, notifications) ────────────

enum ActorType {
  USER
  AGENT
  SYSTEM
}

model Event {
  id         String    @id @default(cuid())
  actorType  ActorType @default(USER)
  actorId    String?
  /// Denormalized so the log stays readable after a user is deleted.
  actorName  String?   @db.VarChar(120)
  /// Dot-namespaced verb, e.g. "auth.login", "team.invite.create".
  action     String    @db.VarChar(80)
  entityType String?   @db.VarChar(40)
  entityId   String?   @db.VarChar(40)
  metadata   Json?
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(512)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("event")
}

// ─── Organization ───────────────────────────────────────────────────────────

/// Single row (id = "org").
model OrgSettings {
  id                     String   @id @default("org")
  name                   String   @default("Klyron Studio") @db.VarChar(120)
  website                String?  @db.VarChar(255)
  billingEmail           String?  @db.VarChar(254)
  defaultCurrency        String   @default("USD") @db.Char(3)
  /// When on, Members only see leads and projects assigned to them.
  membersSeeAssignedOnly Boolean  @default(false)
  /// Billing (Phase 4): shown on proposals and invoices.
  address                String?  @db.Text
  paymentInstructions    String?  @db.Text
  defaultTaxRate         Decimal  @default(0) @db.Decimal(5, 2)
  paymentTermsDays       Int      @default(14)
  invoicePrefix          String   @default("INV") @db.VarChar(10)
  proposalPrefix         String   @default("PRO") @db.VarChar(10)
  invoiceSeq             Int      @default(0)
  proposalSeq            Int      @default(0)
  /// Email clients about overdue invoices (weekly, up to 3 times).
  autoPaymentReminders   Boolean  @default(true)
  /// SHA-256 only; the MCP bearer token is shown once when generated.
  mcpTokenHash           String?  @db.Char(64)
  mcpTokenCreatedAt      DateTime?
  updatedAt              DateTime @updatedAt

  @@map("org_settings")
}

// ─── Pipeline (Phase 1) ─────────────────────────────────────────────────────

enum StageKind {
  OPEN
  WON
  LOST
}

/// Badge color for a stage. Soft tints only (see components/leads/stage-badge.tsx).
enum StageTone {
  NEUTRAL
  INFO
  WARNING
  BRAND
  SUCCESS
}

model PipelineStage {
  id        String    @id @default(cuid())
  name      String    @db.VarChar(60)
  kind      StageKind @default(OPEN)
  tone      StageTone @default(NEUTRAL)
  position  Int
  createdAt DateTime  @default(now())

  leads Lead[]

  @@index([position])
  @@map("pipeline_stage")
}

/// Studio service catalog. Finance (Phase 4) adds pricing on top of this.
model Service {
  id          String           @id @default(cuid())
  name        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  active      Boolean          @default(true)
  /// Catalog price (optional), in the studio default currency.
  price       Decimal?         @db.Decimal(12, 2)
  priceUnit   ServicePriceUnit @default(FIXED)
  position    Int              @default(0)
  createdAt   DateTime         @default(now())

  leads         LeadService[]
  projects      Project[]
  proposalItems ProposalItem[]
  invoiceItems  InvoiceItem[]

  @@map("service")
}

enum LeadSource {
  LEADFORGE
  REFERRAL
  INBOUND
  MANUAL
}

model Lead {
  id          String        @id @default(cuid())
  /// Contact person
  name        String        @db.VarChar(120)
  company     String?       @db.VarChar(120)
  email       String?       @db.VarChar(254)
  phone       String?       @db.VarChar(40)
  website     String?       @db.VarChar(255)
  source      LeadSource    @default(MANUAL)
  value       Decimal       @default(0) @db.Decimal(12, 2)
  currency    String        @default("USD") @db.Char(3)
  stageId     String
  stage       PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  /// Order within the stage column (fractional, so moves only touch one row).
  position    Float         @default(0)
  ownerId     String?
  owner       User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?         @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lostReason  String?       @db.VarChar(40)
  lostDetail  String?       @db.VarChar(500)
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  services  LeadService[]
  notes     LeadNote[]
  reminders Reminder[]
  client    Client?
  proposals Proposal[]

  @@index([stageId, position])
  @@index([ownerId])
  @@index([updatedAt])
  @@map("lead")
}

model LeadService {
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([leadId, serviceId])
  @@map("lead_service")
}

enum NoteType {
  NOTE
  CALL
  MEETING
  EMAIL
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type       NoteType @default(NOTE)
  body       String   @db.Text
  authorId   String?
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Denormalized so notes stay attributed after a member is removed.
  authorName String   @db.VarChar(120)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([leadId, occurredAt])
  @@map("lead_note")
}

model Reminder {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  note        String    @db.VarChar(255)
  dueAt       DateTime
  assigneeId  String?
  assignee    User?     @relation("ReminderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt DateTime?
  /// Set when the due notification has been sent (the scheduler runs every minute).
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([assigneeId, completedAt, dueAt])
  @@index([completedAt, notifiedAt, dueAt])
  @@index([leadId, completedAt])
  @@map("reminder")
}

// ─── Clients (created in Phase 1 by converting leads; extended in Phase 2) ──

model Client {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  contactName String?  @db.VarChar(120)
  email       String?  @db.VarChar(254)
  phone       String?  @db.VarChar(40)
  website     String?  @db.VarChar(255)
  leadId      String?  @unique
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?    @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts  User[]       @relation("ClientAccounts")
  projects  Project[]
  channel   Channel?
  files     StoredFile[]
  proposals Proposal[]
  invoices  Invoice[]
  expenses  Expense[]

  @@index([name])
  @@map("client")
}

// ─── Projects (Phase 2) ─────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(120)
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId   String?
  service     Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  /// Project lead
  ownerId     String?
  owner       User?         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  startDate   DateTime?     @db.Date
  dueDate     DateTime?     @db.Date
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members    ProjectMember[]
  milestones Milestone[]
  tasks      Task[]
  files      StoredFile[]
  invoices   Invoice[]
  expenses   Expense[]

  @@index([clientId])
  @@index([status])
  @@index([ownerId])
  @@map("project")
}

model ProjectMember {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String    @db.VarChar(120)
  dueDate     DateTime? @db.Date
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  tasks Task[]

  @@index([projectId, position])
  @@map("milestone")
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  dueDate     DateTime?    @db.Date
  /// Order within the status column (fractional, like leads).
  position    Float        @default(0)
  completedAt DateTime?
  createdById String?
  createdBy   User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId, status, position])
  @@index([assigneeId, status])
  @@index([milestoneId])
  @@map("task")
}

// ─── Chat (Phase 3) ─────────────────────────────────────────────────────────

enum ChannelKind {
  /// Team-only room, visible to every team member with chat access
  TEAM
  /// One per client: the team plus that client's portal accounts
  CLIENT
  /// Private conversation between specific team members
  DIRECT
  /// Private named group: only its members (chosen by the creator) can see it.
  GROUP
}

model Channel {
  id            String      @id @default(cuid())
  kind          ChannelKind
  name          String?     @db.VarChar(80)
  clientId      String?     @unique
  client        Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Sorted participant ids for DIRECT channels, so a pair maps to one channel.
  directKey     String?     @unique @db.VarChar(255)
  lastMessageAt DateTime?
  /// Who created a GROUP (they and Owners/Admins manage its members).
  createdById   String?
  createdBy     User?       @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  members  ChannelMember[]
  messages Message[]
  files    StoredFile[]
  calls    Call[]

  @@index([kind, lastMessageAt])
  @@map("channel")
}

/// Membership for DIRECT channels, and read state for every channel a user opens.
model ChannelMember {
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  @@id([channelId, userId])
  @@index([userId])
  @@map("channel_member")
}

model Message {
  id         String    @id @default(cuid())
  channelId  String
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Denormalized so messages stay attributed after an account is removed.
  authorName String    @db.VarChar(120)
  /// AI replies ("@Klyron AI") have no author account.
  fromAi     Boolean   @default(false)
  body       String    @db.Text
  editedAt   DateTime?
  deletedAt  DateTime?
  /// Set for "started a call" messages, rendered as a call card.
  callId     String?
  call       Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  files StoredFile[]

  @@index([channelId, createdAt])
  @@map("message")
}

// ─── Files ──────────────────────────────────────────────────────────────────

enum FileKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

/// A file on local disk (UPLOAD_DIR). The disk path comes from storageKey, never from user input.
model StoredFile {
  id               String   @id @default(cuid())
  storageKey       String   @unique @db.VarChar(120)
  name             String   @db.VarChar(255)
  mimeType         String   @db.VarChar(120)
  size             BigInt
  kind             FileKind
  width            Int?
  height           Int?
  /// A smaller WebP preview for images, stored next to the original.
  hasThumbnail     Boolean  @default(false)
  /// Voice notes recorded in chat: shown as a player with a waveform.
  voiceNote        Boolean  @default(false)
  durationMs       Int?
  /// ~48 bar heights (0-100) for the voice note waveform.
  waveform         Json?
  uploadedById     String?
  uploadedBy       User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  channelId        String?
  channel          Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messageId        String?
  message          Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Visible in the client portal. Files posted in a client's chat are always shared.
  sharedWithClient Boolean  @default(false)
  /// Company document vault (internal, not tied to a client).
  company          Boolean  @default(false)
  /// Optional folder in the company vault, e.g. "Contracts".
  folder           String?  @db.VarChar(80)
  /// Company file visible to Owners and Admins only.
  restricted       Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([projectId])
  @@index([channelId])
  @@index([messageId])
  @@index([company, folder])
  @@map("stored_file")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. "chat.message", "task.assigned", "reminder.due"
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  link      String?   @db.VarChar(255)
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

// ─── Finance (Phase 4) ──────────────────────────────────────────────────────
// Money is Decimal(12,2) and always calculated in cents (lib/finance/math.ts).
// Totals are stored on the document so history never changes when prices do.

enum ServicePriceUnit {
  FIXED
  HOURLY
  DAILY
  MONTHLY
}

/// Expired is derived from validUntil, never stored.
enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

/// Overdue and partly paid are derived from dueDate and amountPaid.
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  CHEQUE
  ONLINE
  OTHER
}

enum ExpenseCategory {
  SOFTWARE
  HARDWARE
  CONTRACTORS
  MARKETING
  OFFICE
  TRAVEL
  TAXES_FEES
  OTHER
}

model Proposal {
  id           String         @id @default(cuid())
  number       String         @unique @db.VarChar(24)
  title        String         @db.VarChar(160)
  status       ProposalStatus @default(DRAFT)
  /// Sent to a client, or to a lead before they become one.
  clientId     String?
  client       Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  leadId       String?
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  currency     String         @db.Char(3)
  issueDate    DateTime       @db.Date
  validUntil   DateTime?      @db.Date
  introduction String?        @db.Text
  terms        String?        @db.Text
  discount     Decimal        @default(0) @db.Decimal(12, 2)
  taxRate      Decimal        @default(0) @db.Decimal(5, 2)
  subtotal     Decimal        @default(0) @db.Decimal(12, 2)
  total        Decimal        @default(0) @db.Decimal(12, 2)
  /// Secret link for the recipient (/p/<token>); no account needed.
  publicToken  String         @unique @db.VarChar(64)
  sentAt       DateTime?
  viewedAt     DateTime?
  respondedAt  DateTime?
  responseNote String?        @db.VarChar(1000)
  createdById  String?
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  items    ProposalItem[]
  invoices Invoice[]

  @@index([status])
  @@index([clientId])
  @@index([leadId])
  @@map("proposal")
}

model ProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description String   @db.VarChar(500)
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  position    Int

  @@index([proposalId, position])
  @@map("proposal_item")
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique @db.VarChar(24)
  status         InvoiceStatus @default(DRAFT)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  proposalId     String?
  proposal       Proposal?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  currency       String        @db.Char(3)
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  notes          String?       @db.Text
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  subtotal       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  /// Secret link for the client (/i/<token>); no account needed.
  publicToken    String        @unique @db.VarChar(64)
  sentAt         DateTime?
  viewedAt       DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  lastReminderAt DateTime?
  reminderCount  Int           @default(0)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([status, dueDate])
  @@index([clientId])
  @@index([projectId])
  @@map("invoice")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description String   @db.VarChar(500)
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  position    Int

  @@index([invoiceId, position])
  @@map("invoice_item")
}

model Payment {
  id           String        @id @default(cuid())
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal       @db.Decimal(12, 2)
  paidOn       DateTime      @db.Date
  method       PaymentMethod @default(BANK_TRANSFER)
  reference    String?       @db.VarChar(120)
  note         String?       @db.VarChar(500)
  recordedById String?
  recordedBy   User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidOn])
  @@map("payment")
}

model Expense {
  id          String          @id @default(cuid())
  spentOn     DateTime        @db.Date
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @db.Char(3)
  category    ExpenseCategory @default(OTHER)
  vendor      String?         @db.VarChar(120)
  description String          @db.VarChar(500)
  clientId    String?
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([spentOn])
  @@index([clientId])
  @@index([projectId])
  @@map("expense")
}

// ─── Calls (Phase 5) ────────────────────────────────────────────────────────
// Video calls run on a self-hosted LiveKit server; the CRM issues join tokens.
// Each participant's browser transcribes their own microphone (opt-out per person),
// and Groq turns the transcript into meeting notes after the call.

enum CallStatus {
  ACTIVE
  ENDED
}

enum NotesStatus {
  NONE
  PENDING
  READY
  FAILED
}

model Call {
  id          String      @id @default(cuid())
  title       String      @db.VarChar(160)
  /// Every call belongs to a chat conversation, which decides who may join.
  channelId   String
  channel     Channel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// LiveKit room name (unguessable; never reused).
  roomName    String      @unique @db.VarChar(64)
  status      CallStatus  @default(ACTIVE)
  startedById String?
  startedBy   User?       @relation("CallStarter", fields: [startedById], references: [id], onDelete: SetNull)
  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  notesStatus NotesStatus @default(NONE)
  summary     String?     @db.Text
  /// [{ text }]
  decisions   Json?
  /// [{ text, owner, due }]
  actionItems Json?
  notesModel  String?     @db.VarChar(80)
  notesError  String?     @db.VarChar(500)
  notesAt     DateTime?

  participants CallParticipant[]
  segments     TranscriptSegment[]
  messages     Message[]

  @@index([channelId, startedAt])
  @@index([status, startedAt])
  @@index([notesStatus])
  @@map("call")
}

model CallParticipant {
  callId   String
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@id([callId, userId])
  @@index([userId])
  @@map("call_participant")
}

/// One finalized phrase from a participant's browser speech recognition.
model TranscriptSegment {
  id          String   @id @default(cuid())
  callId      String
  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  speakerName String   @db.VarChar(120)
  text        String   @db.Text
  spokenAt    DateTime @db.DateTime(3)

  @@index([callId, spokenAt])
  @@map("transcript_segment")
}

// ─── Whiteboards (Phase 8) ────────────────────────────────────────────────

model Whiteboard {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  /// Versioned canvas document: { version, nodes }.
  content     Json
  createdById String?
  createdBy   User?    @relation("WhiteboardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revision    Int      @default(0)
  favorite    Boolean  @default(false)
  lastOpenedAt DateTime?

  versions WhiteboardVersion[]
  members  WhiteboardMember[]
  comments WhiteboardComment[]

  @@index([updatedAt])
  @@map("whiteboard")
}

model WhiteboardMember {
  boardId String
  board   Whiteboard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  access  Access     @default(READ)

  @@id([boardId, userId])
  @@index([userId])
  @@map("whiteboard_member")
}

model WhiteboardComment {
  id         String     @id @default(cuid())
  boardId    String
  board      Whiteboard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String     @db.Text
  x          Float
  y          Float
  resolvedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([boardId, createdAt])
  @@map("whiteboard_comment")
}

model WhiteboardVersion {
  id          String     @id @default(cuid())
  boardId     String
  board       Whiteboard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  revision    Int
  content     Json
  createdById String?
  createdBy   User?      @relation("WhiteboardVersionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@unique([boardId, revision])
  @@index([boardId, createdAt])
  @@map("whiteboard_version")
}
